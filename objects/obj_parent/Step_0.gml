if(Layer == global.layer){
	colour = global.selected_colour;
}
if global.layer == 0{
	hair = colour;
}
else if global.layer == 1{
	eye = colour;
}
else if global.layer == 2{
	eyebrow = colour;
}
else if global.layer == 3{
	top = colour;
}
else if global.layer == 4{
	bottom = colour;
}
else if global.layer == 5{
	shoe = colour;
}
else if global.layer == 6{
	skin = colour;
}
